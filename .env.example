# 复制成 .env 再改。改完重启：systemctl restart yuzu

# 网站监听的端口
PORT=8787
HOST=0.0.0.0

# 进门暗号（网站登录密码）。一定要改成你自己的长密码！
SITE_PASSWORD=

# DeepSeek 密钥，在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 她干活时默认待在哪个目录
WORKDIR=/root

# 数据目录（聊天记录、记忆、音乐都在这里）
DATA_DIR=./data

# 用 HTTPS 域名访问时改成 true（让登录 cookie 只走 HTTPS）
COOKIE_SECURE=false
